exports[`Détaillé neuf : rendu de fond figé (N6) > fr · ouverture 1`] = `
"<div class="av-estim av-neuf-d">
<div style="display:flex;justify-content:flex-end;margin-bottom:12px">
<div class="views" role="group" aria-label="Vue">
<button type="button" class="on" aria-pressed="true">Ma saisie</button>
<button type="button" class="" aria-pressed="false">Mon devis</button>
</div>
</div>
<div>
<div class="card">
<div class="eyebrow">Ta maison</div>
<h2>Parle-nous de ta maison</h2>
<div class="sub">Chaque réponse coche et mesure les postes ; tu ajustes ensuite. Ce que tu règles à la main, poste par poste, est gardé.</div>
<div class="gl">Type de maison</div>
<div class="typef">
<div class="typef-g">
<div class="tpills" role="group" aria-label="Niveaux">
<button type="button" class="tpill on" aria-pressed="true">Plain-pied</button>
<button type="button" class="tpill" aria-pressed="false">À étage</button>
<button type="button" class="tpill" aria-pressed="false">Combles aménagés</button>
</div>
</div>
<div class="typef-g">
<span class="typef-l" aria-hidden="true">Forme</span>
<div class="tpills" role="group" aria-label="Forme">
<button type="button" class="tpill on" aria-pressed="true">Simple</button>
<button type="button" class="tpill" aria-pressed="false">En L</button>
<button type="button" class="tpill" aria-pressed="false">Complexe</button>
</div>
</div>
</div>
<div class="gl">Surfaces</div>
<div class="depart">
<div class="fld">
<label for="av-neuf-surface">Surface habitable</label>
<span class="av-step field">
<input id="av-neuf-surface" type="number" inputMode="decimal" min="30" max="400" step="5" value="100"/>
<span class="u">m²</span>
<span class="st">
<button type="button" aria-label="Diminuer">−</button>
<button type="button" aria-label="Augmenter">+</button>
</span>
</span>
<div style="font-size:11.5px;color:var(--faint);line-height:1.45;margin-top:6px">Tous les niveaux additionnés, hors garage.</div>
</div>
<div class="fld">
<label for="av-neuf-garage">Garage accolé</label>
<span class="av-step field">
<input id="av-neuf-garage" type="number" inputMode="decimal" min="0" max="80" step="5" value="0"/>
<span class="u">m²</span>
<span class="st">
<button type="button" disabled="" aria-label="Diminuer">−</button>
<button type="button" aria-label="Augmenter">+</button>
</span>
</span>
<div style="font-size:11.5px;color:var(--faint);line-height:1.45;margin-top:6px">0 = sans garage</div>
</div>
<div class="fld">
<label for="av-neuf-codePostal">Code postal du terrain</label>
<div class="uinp">
<input id="av-neuf-codePostal" inputMode="numeric" maxLength="5" autoComplete="postal-code" placeholder="ex. 45000" value=""/>
</div>
</div>
<div class="fld">
<label for="av-neuf-hauteur">Hauteur sous plafond</label>
<output id="av-neuf-hauteur" class="ro">
<span class="num">2,50</span>
<span class="u">m</span>
</output>
<div style="font-size:11.5px;color:var(--faint);line-height:1.45;margin-top:6px">Standard d&#x27;une maison neuve.</div>
</div>
</div>
<div class="gl">Pièces &amp; configuration <span style="text-transform:none;letter-spacing:0;font-weight:500">· chaque pièce compte dans le chiffrage</span>
</div>
<div class="stpg">
<div class="stp">
<span class="l">Séjour / salon</span>
<span class="c">
<button type="button" aria-label="moins">−</button>
<span class="v num">1</span>
<button type="button" aria-label="plus">+</button>
</span>
</div>
<div class="stp">
<span class="l">Cuisine</span>
<span class="c">
<button type="button" aria-label="moins">−</button>
<span class="v num">1</span>
<button type="button" aria-label="plus">+</button>
</span>
</div>
<div class="stp">
<span class="l">Chambres</span>
<span class="c">
<button type="button" aria-label="moins">−</button>
<span class="v num">3</span>
<button type="button" aria-label="plus">+</button>
</span>
</div>
<div class="stp">
<span class="l">Suite parentale<small>chambre + SDB</small>
</span>
<span class="c">
<button type="button" aria-label="moins">−</button>
<span class="v num">0</span>
<button type="button" aria-label="plus">+</button>
</span>
</div>
<div class="stp">
<span class="l">Salles de bain<small>hors suite</small>
</span>
<span class="c">
<button type="button" aria-label="moins">−</button>
<span class="v num">1</span>
<button type="button" aria-label="plus">+</button>
</span>
</div>
<div class="stp">
<span class="l">WC</span>
<span class="c">
<button type="button" aria-label="moins">−</button>
<span class="v num">1</span>
<button type="button" aria-label="plus">+</button>
