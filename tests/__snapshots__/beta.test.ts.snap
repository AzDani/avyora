<div class="wrap"><style>.av-home .accb{margin-top:22px;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:34px;align-items:center;background:var(--surface);border:1px solid var(--line-strong);border-radius:var(--r-lg);box-shadow:var(--shadow);padding:40px}.av-home .accb .badge{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:#0b6e4b;background:var(--good-bg);border-radius:999px;padding:6px 12px;margin-top:14px}.av-home .accb .badge i{width:7px;height:7px;border-radius:50%;background:var(--good);display:inline-block}.av-home .accb h2{font-size:clamp(24px,3.2vw,32px);font-weight:700;line-height:1.14;margin-top:10px;color:var(--nuit);text-wrap:balance}.av-home .accb p.d{color:var(--muted);font-size:15.5px;line-height:1.6;margin-top:12px;max-width:56ch}.av-home .accb p.qui{font-size:13.5px;color:var(--ink);margin-top:14px;line-height:1.5}.av-home .accb p.qui b{font-weight:600}.av-home .accb p.et{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-top:20px}.av-home .accb ol.etapes{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:8px}.av-home .accb ol.etapes li{display:flex;gap:12px;align-items:flex-start;font-size:14.5px;color:var(--ink);line-height:1.45}.av-home .accb ol.etapes .n{flex:none;width:24px;height:24px;border-radius:7px;background:var(--brand);color:#fff;font-size:12.5px;font-weight:700;display:grid;place-items:center;font-family:var(--font-geist-mono),monospace}.av-home .accb .cta{display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;margin-top:22px}.av-home .accb .lien{color:var(--brand-700);font-weight:600;font-size:14.5px;text-decoration:underline;text-underline-offset:3px;min-height:44px;display:inline-flex;align-items:center}.av-home .accb ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.av-home .accb li a{display:flex;align-items:center;gap:14px;padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);text-decoration:none;color:inherit;transition:border-color .15s,transform .15s}.av-home .accb li a:hover{border-color:var(--brand-200);transform:translateX(3px)}.av-home .accb li a:focus-visible{outline:3px solid var(--brand-200);outline-offset:2px}.av-home .accb li .ic{flex:none;width:36px;height:36px;border-radius:10px;background:var(--brand-weak);color:var(--brand-700);display:inline-flex;align-items:center;justify-content:center}.av-home .accb li .t{font-weight:600;font-size:14.5px;color:var(--ink)}.av-home .accb li .s{font-size:13px;color:var(--muted);margin-top:2px;line-height:1.45}.av-home .accb li .fl{margin-left:auto;color:var(--brand-700);font-weight:600}@media(max-width:820px){.av-home .accb{grid-template-columns:1fr;padding:28px 22px;gap:24px}}@media (prefers-reduced-motion:reduce){.av-home .accb li a{transition:none}.av-home .accb li a:hover{transform:none}}</style><section class="accb" aria-labelledby="accb-titre"><div>
  <p class="eyebrow">Renovation advice</p>
  <h2 id="accb-titre">What I do for you.</h2>
  <p class="d">You keep your contractors and your decisions: I bring a professional's eye to your project, remotely, by video call or WhatsApp. It's advice, not project management, and I take nothing on the works.</p>
  <p class="et">How it works</p><ol class="etapes"><li><span class="n">1</span><span>You request a call-back, in one minute.</span></li><li><span class="n">2</span><span>First call free: we look at your project together.</span></li><li><span class="n">3</span><span>I suggest the support that helps you, no commitment.</span></li></ol>
  <div class="cta"><a href="/accompagnement-travaux#demande" class="btn btn-p">Request a call-back →</a><a href="/accompagnement-travaux" class="lien">Discover the service</a></div>
</div><ul aria-label="What I can do for you">
  <li><a href="/accompagnement-travaux#aide"><span class="ic"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 2.5h7l3 3v12H5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 9.5h4.5M8 12.5h4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span><span><span class="t" style="display:block">Review of your quotes</span><span class="s" style="display:block">Prices, omissions, terms: what to renegotiate before you sign.</span></span><span class="fl" aria-hidden="true">→</span></a></li>
