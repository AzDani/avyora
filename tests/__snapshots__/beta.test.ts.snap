0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Estimateur détaillé — les 200 postes, au poste près</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Choix fait-faire / je fais sur chaque tâche</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Export du rapport PDF (banque, artisans)</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Sauvegarde de tous tes projets</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Suivi de chantier, poste par poste</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Construction neuve : ta maison détaillée phase par phase, d