"round"></path><circle cx="17.5" cy="7" r="2.2" fill="currentColor"></circle><circle cx="13.5" cy="17" r="2.2" fill="currentColor"></circle></svg></span><span class="tag propill" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 1l2 4 4 .5-3 3 .8 4.3L8 11l-3.8 1.8L5 8.5 2 5.5 6 5l2-4Z" fill="currentColor"></path></svg>Beta</span></div><h2>Detailed estimate</h2><p class="lead">Describe your house (structure, roof, heating, plot) and adjust every item, phase by phase.</p><ul><li><svg class="ck-pro" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Phase by phase, from permit to handover</span></li><li><svg class="ck-pro" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Adjustable items and quantities, admin steps and milestones</span></li><li><svg class="ck-pro" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>PDF report and build tracking</span></li></ul><div class="spacer"></div><a class="btn btn-pro" href="/projets/nouveau/construction?new=1">Adjust line by line →</a><p class="foot"><svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 1l2 4 4 .5-3 3 .8 4.3L8 11l-3.8 1.8L5 8.5 2 5.5 6 5l2-4Z" fill="var(--color-accent-500)"></path></svg>Included during the beta, through December 31, 2026</p></section></div><aside class="plan-band" aria-label="Start from my plan"><span class="plan-ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 16 16" fill="none"><path d="M2.5 7.2 8 2.6l5.5 4.6V13a.8.8 0 0 1-.8.8H3.3a.8.8 0 0 1-.8-.8V7.2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M6.3 13.8V9.6h3.4v4.2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg></span><div class="plan-txt"><p class="plan-titre">Start from my plan</p><p class="plan-d">Already picturing your house? Draw it: its rooms and floor area fill in the estimate.</p><p class="plan-partir" aria-live="polite"></p><p class="plan-tel">Drawing works on a computer or a tablet.</p></div><a href="/plan?type=final" class="btn btn-outline plan-go" data-clic-plan="choix">Draw my house →</a></aside><div class="hint"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4"></circle><path d="M10 9v5M10 6.2v.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg><span>Not sure? Start with the <b>quick estimate</b> — you can switch to detailed anytime, your answers are kept.</span></div></div>"
