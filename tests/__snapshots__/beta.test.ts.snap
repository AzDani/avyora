exports[`Témoins · pendant la bêta (12/10/2026) > Mon compte : la bêta et le membre fondateur, rien à résilier ; l'abonné garde la gestion de son abonnement > abonnement bêta en fondateur 1`] = `"<section class="card p-5"><div class="flex items-start justify-between gap-3"><div><h2 class="font-semibold text-ink">Subscription</h2><p class="mt-1 text-sm text-muted">Free beta: you have access to every feature through December 31, 2026.</p></div><span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold bg-brand-50 text-brand-600">Free beta</span></div><div class="mt-4"><p class="text-xs text-faint">No payment method on file: nothing will be charged. We&#x27;ll email you before the beta ends.</p><p class="mt-3 text-[13px] text-muted">Founding member: your account dates from the AVYORA beta. Thanks for being here from the start.</p></div></section>"`;

exports[`Témoins · pendant la bêta (12/10/2026) > Mon compte : la bêta et le membre fondateur, rien à résilier ; l'abonné garde la gestion de son abonnement > abonnement bêta fr fondateur 1`] = `"<section class="card p-5"><div class="flex items-start justify-between gap-3"><div><h2 class="font-semibold text-ink">Abonnement</h2><p class="mt-1 text-sm text-muted">Bêta gratuite : tu profites de toutes les fonctionnalités jusqu&#x27;au 31 décembre 2026.</p></div><span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold bg-brand-50 text-brand-600">Bêta gratuite</span></div><div class="mt-4"><p class="text-xs text-faint">Aucun moyen de paiement enregistré : rien ne sera prélevé. On te préviendra par e-mail avant la fin de la bêta.</p><p class="mt-3 text-[13px] text-muted">Membre fondateur : ton compte date de la bêta d&#x27;AVYORA. Merci d&#x27;être là depuis le début.</p></div></section>"`;

exports[`Témoins · pendant la bêta (12/10/2026) > Tarifs (FR, EN ; anonyme, gratuit, Pro ; venu de l'éditeur) > tarifs bêta en anonyme 1`] = `"<div class="animate-rise mx-auto max-w-4xl py-4 sm:py-8" data-tarifs-beta=""><header class="text-center"><p class="eyebrow">Free beta</p><h1 class="mt-2 text-[30px] font-semibold tracking-tight text-ink">All of AVYORA is free through December 31, 2026</h1><p class="mx-auto mt-3 max-w-xl text-[15px] leading-relaxed text-muted">All you need is an account. No payment method is required, and nothing will ever be charged automatically: not during the beta, not after.</p></header><div class="mx-auto mt-6 max-w-md text-center"><a class="btn btn-primary w-full justify-center py-3 text-[15px]" href="/inscription?source=tarifs">Create my free account</a><p class="mt-3 text-[13px] text-muted">Already have an account? <a class="font-medium text-brand-600 hover:underline" href="/connexion">Sign in</a></p></div><div class="mt-6 overflow-hidden rounded-panel bg-gradient-to-r from-[#4F46E5] via-[#6d5cf0] to-[#7C3AED] px-6 py-5 text-center text-white shadow-card" data-tarifs-fondateur=""><div class="text-[11px] font-bold uppercase tracking-[0.16em] text-indigo-100/90">Founding members</div><h2 class="mt-1 text-[20px] font-semibold tracking-tight">Create your account during the beta: you become a founding member</h2><div class="mt-1 text-[13.5px] text-indigo-100/85">A badge on your account, reserved for beta sign-ups.</div><div class="mx-auto mt-2 max-w-xl text-[12.5px] text-indigo-100/75">Nothing will be charged: once AVYORA becomes paid, you subscribe only if you want to.</div></div><div class="mx-auto mt-8 grid max-w-3xl gap-6 rounded-panel border border-line bg-surface p-6 sm:grid-cols-[1fr_240px] sm:items-start sm:gap-8"><div><h2 class="eyebrow mb-3">Included during the beta</h2><ul class="space-y-2.5"><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Detailed estimator — all 200 items, line by line</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>DIY vs. hire-out choice on every task</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>PDF report export (bank, contractors)</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Save all your projects</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>Project tracking, line by line</li><li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-ink"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>New build: your house detailed trade by trade, from permit to completion</li></ul></div><figure class="mx-auto w-full max-w-[240px]"><picture><source type="image/webp" srcSet="/exemple-rapport-760.webp 760w, /exemple-rapport-1040.webp 1040w" sizes="240px"/><img src="/exemple-rapport.png" alt="Example of a detailed AVYORA estimate report" width="1040" height="1458" loading="lazy" decoding="async" class="w-full rounded-field border border-line shadow-card"/></picture><figcaption class="mt-2.5 text-center text-[11px] leading-snug text-faint">Example of a detailed report — 145 m² house in Bordeaux.</figcaption></figure></div><section class="mx-auto mt-8 max-w-3xl" data-tarifs-faq=""><h2 class="text-[18px] font-semibold tracking-tight text-ink">Frequently asked questions</h2><dl class="mt-4 space-y-4"><div class="rounded-field border border-line bg-surface px-5 py-4"><dt class="text-[14.5px] font-semibold text-ink">What happens on January 1, 2027 if I don&#x27;t subscribe?</dt><dd class="mt-1.5 text-[14px] leading-relaxed text-muted">Nothing is deleted: your projects and estimates stay in your account, and you can still open them. Your account goes back to free: the quick estimate stays open (a detailed project reopens in the quick estimate), but the detailed estimate, the PDF report and project tracking then require a subscription. Your founding member badge stays.</dd></div><div class="rounded-field border border-line bg-surface px-5 py-4"><dt class="text-[14.5px] font-semibold text-ink">Do I need a credit card?</dt><dd class="mt-1.5 text-[14px] leading-relaxed text-muted">No. No payment method is requested during the beta, and nothing will be charged automatically: once AVYORA becomes paid, you subscribe only if you want to.</dd></div><div class="rounded-field border border-line bg-surface px-5 py-4"><dt class="text-[14.5px] font-semibold text-ink">What is a founding member?</dt><dd class="mt-1.5 text-[14px] leading-relaxed text-muted">It&#x27;s the status of accounts whose email address was confirmed during the beta: a badge on your account, which stays after the beta. It comes with no pricing advantage: once AVYORA becomes paid, you subscribe at the current rate, only if you want to.</dd></div><div class="rounded-field border border-line bg-surface px-5 py-4"><dt class="text-[14.5px] font-semibold text-ink">Can I delete my account?</dt><dd class="mt-1.5 text-[14px] leading-relaxed text-muted">Yes, at any time, from My account: your account and everything in it (projects, estimates, floor plans) are then permanently deleted.</dd></div></dl></section><p class="mt-6 text-center text-[13px] text-muted">Not ready to create an account? <a class="font-medium text-brand-600 hover:underline" href="/projets/nouveau">Run a quick estimate of one room or your whole home, no account needed</a>.</p></div>"`;

