@media (max-width:720px){.av-choix .grid{grid-template-columns:1fr}}
.av-choix .ch-card{position:relative;background:var(--color-surface);border:1px solid var(--color-line);border-radius:20px;
  padding:24px 22px;box-shadow:0 1px 2px rgba(21,23,43,.04),0 12px 30px -22px rgba(21,23,43,.30);display:flex;flex-direction:column}
.av-choix .ch-card.pro{border-color:var(--color-brand-200)}
.av-choix .ch-card.pro::before{content:"";position:absolute;inset:0;border-radius:20px;padding:1px;
  background:linear-gradient(140deg,var(--color-accent-400),var(--color-brand-600));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.5;pointer-events:none}
.av-choix .row1{display:flex;align-items:center;justify-content:space-between;gap:10px}
.av-choix .ico{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;flex:none}
.av-choix .ico.free{background:var(--color-brand-50);color:var(--color-brand-600)}
.av-choix .ico.pro{background:linear-gradient(140deg,#2b2568,var(--color-brand-900));color:var(--color-accent-300)}
.av-choix .tag{font-size:11px;font-weight:600;letter-spacing:.03em;padding:5px 11px;border-radius:999px;white-space:nowrap}
.av-choix .tag.gratis{background:var(--color-positive-soft);color:var(--color-positive)}
.av-choix .tag.propill{background:linear-gradient(120deg,var(--color-accent-600),var(--color-brand-600));color:#fff;display:inline-flex;align-items:center;gap:5px}
.av-choix .ch-card h2{font-size:20px;font-weight:600;margin:18px 0 0;letter-spacing:-.01em;color:var(--color-ink)}
.av-choix .lead{color:var(--color-muted);font-size:14px;margin:7px 0 0;line-height:1.6}
.av-choix ul{list-style:none;margin:18px 0 0;padding:0;display:flex;flex-direction:column;gap:11px}
.av-choix li{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--color-ink);line-height:1.5}
.av-choix li svg{flex:none;margin-top:2px}
.av-choix .ck-free{color:var(--color-brand-600)}
.av-choix .ck-pro{color:var(--color-accent-600)}
.av-choix .spacer{flex:1;min-height:18px}
.av-choix .btn{width:100%}
.av-choix .btn-outline{background:var(--color-surface);color:var(--color-brand-700);border:1px solid var(--color-line-strong)}
.av-choix .btn-outline:hover{background:var(--color-surface-2)}
.av-choix .btn-pro{background:linear-gradient(120deg,var(--color-accent-600),var(--color-brand-600));color:#fff;border:1px solid transparent}
.av-choix .btn-pro:hover{filter:brightness(1.06)}
.av-choix .foot{font-size:12.5px;color:var(--color-faint);margin-top:9px;text-align:center;display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap}
.av-choix .foot .lien{color:var(--color-brand-600);text-decoration:none;font-weight:500}
.av-choix .foot .lien:hover{text-decoration:underline}
.av-choix .hint{margin-top:22px;background:var(--color-surface-2);border:1px solid var(--color-line);border-radius:14px;padding:13px 16px;font-size:13px;color:var(--color-muted);display:flex;gap:10px;align-items:center;line-height:1.5}
.av-choix .hint svg{flex:none;color:var(--color-brand-500)}
.av-choix .hint b{color:var(--color-ink);font-weight:600}

.av-choix .sur{display:flex;align-items:center;gap:6px 10px;flex-wrap:wrap}
.av-choix .changer{display:inline-flex;align-items:center;min-height:30px;padding:0 12px;border-radius:999px;border:1px solid var(--color-line);background:var(--color-surface);font-size:12.5px;font-weight:500;color:var(--color-brand-700);text-decoration:none;transition:background .15s,border-color .15s}
.av-choix .changer:hover{border-color:var(--color-brand-300);background:var(--color-brand-50)}
.av-choix .changer:focus-visible{outline:2px solid var(--color-brand-500);outline-offset:2px}
@media (pointer:coarse){.av-choix .changer{min-height:44px;padding:0 16px}}

.av-choix .plan-band{margin-top:18px;display:flex;align-items:center;gap:16px;background:var(--color-surface);border:1px dashed var(--color-brand-200);border-radius:16px;padding:16px 18px}
.av-choix .plan-ico{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex:none;background:var(--color-brand-50);color:var(--color-brand-600)}
.av-choix .plan-txt{flex:1;min-width:0}
.av-choix .plan-titre{margin:0;font-size:15px;font-weight:600;color:var(--color-ink);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.av-choix .plan-d{margin:3px 0 0;font-size:13.5px;color:var(--color-muted);line-height:1.5}
.av-choix .plan-partir{margin:4px 0 0;min-height:1.25rem;font-size:13.5px}
.av-choix .plan-partir .lien{color:var(--color-brand-600);font-weight:500;text-decoration:none}
.av-choix .plan-partir .lien:hover{text-decoration:underline}
.av-choix .plan-band .plan-go{width:auto;flex:none;white-space:nowrap}
@media (max-width:720px){.av-choix .plan-band{flex-wrap:wrap}.av-choix .plan-ico{display:none}.av-choix .plan-band .plan-go{width:100%}}
.av-choix .plan-tel{display:none;margin:4px 0 0;font-size:12.5px;color:var(--color-faint)}
@media (max-width:600px){.av-choix .plan-tel{display:block}}
</style><header class="animate-rise"><div class="sur"><p class="eyebrow">New estimate · New build</p><a class="changer" aria-label="Change project type" href="/projets/nouveau">Change</a></div><h1 class="ttl">How do you want to estimate your house?</h1><p class="sub">Your house, from building permit to handover. Start quick, refine whenever you like — without re-entering anything.</p></header><div class="grid"><section class="ch-card"><div class="row1"><span class="ico free" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="currentColor"></path></svg></span><span class="tag gratis">Free</span></div><h2>Quick estimate</h2><p class="lead">4 questions, an instant all-in budget. Ideal for a first ballpark figure.</p><ul><li><svg class="ck-free" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Single-story or two-story, floor area, ZIP code of the plot</span></li><li><svg class="ck-free" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Studies, taxes, construction and utility hookups included</span></li><li><svg class="ck-free" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>No sign-up, instant result</span></li></ul><div class="spacer"></div><a class="btn btn-outline" href="/estimation-construction-maison">Start for free →</a><p class="foot">No card required</p></section><section class="ch-card pro"><div class="row1"><span class="ico pro" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 7h10M4 12h16M4 17h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><circle cx="17.5" cy="7" r="2.2" fill="currentColor"></circle><circle cx="13.5" cy="17" r="2.2" fill="currentColor"></circle></svg></span><span class="tag propill" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 1l2 4 4 .5-3 3 .8 4.3L8 11l-3.8 1.8L5 8.5 2 5.5 6 5l2-4Z" fill="currentColor"></path></svg>Beta</span></div><h2>Detailed estimate</h2><p class="lead">Describe your house (structure, roof, heating, plot) and adjust every item, trade by trade.</p><ul><li><svg class="ck-pro" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Trade by trade, from permit to handover</span></li><li><svg class="ck-pro" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Adjustable items and quantities, admin steps and milestones</span></li><li><svg class="ck-pro" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>PDF report and build tracking</span></li></ul><div class="spacer"></div><a class="btn btn-pro" href="/inscription?next=%2Fprojets%2Fnouveau%2Fconstruction%3Fnew%3D1&amp;source=choix-neuf">Create my free account →</a><p class="foot"><svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 1l2 4 4 .5-3 3 .8 4.3L8 11l-3.8 1.8L5 8.5 2 5.5 6 5l2-4Z" fill="var(--color-accent-500)"></path></svg>Free during the beta, all you need is an account.</p></section></div><aside class="plan-band" aria-label="Start from my plan"><span class="plan-ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 16 16" fill="none"><path d="M2.5 7.2 8 2.6l5.5 4.6V13a.8.8 0 0 1-.8.8H3.3a.8.8 0 0 1-.8-.8V7.2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path><path d="M6.3 13.8V9.6h3.4v4.2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg></span><div class="plan-txt"><p class="plan-titre">Start from my plan</p><p class="plan-d">Already picturing your house? Draw it: its rooms and floor area fill in the estimate.</p><p class="plan-partir" aria-live="polite"></p><p class="plan-tel">Drawing works on a computer or a tablet.</p></div><a href="/inscription?next=%2Fplan%3Ftype%3Dfinal&amp;source=choix-plan" class="btn btn-outline plan-go" data-clic-plan="choix">Create your free account to start drawing →</a></aside><div class="hint"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4"></circle><path d="M10 9v5M10 6.2v.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg><span>Not sure? Start with the <b>quick estimate</b> — you can switch to detailed anytime, your answers are kept.</span></div></div>"
`;

