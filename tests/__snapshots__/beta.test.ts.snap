  <li><a href="/accompagnement-travaux#aide"><span class="ic"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="5" width="10.5" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m13 9 4.5-2.5v7L13 11" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span><span class="t" style="display:block">Video walkthrough before you buy</span><span class="s" style="display:block">A professional's eye on the property before you make an offer.</span></span><span class="fl" aria-hidden="true">→</span></a></li>
  <li><a href="/accompagnement-achat-revente"><span class="ic"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 9.5 10 3.8l7 5.7V17H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 15.5v-5M7.8 12.6 10 10.4l2.2 2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><span class="t" style="display:block">Buy, renovate, resell</span><span class="s" style="display:block">A professional's eye at every step (page in French).</span></span><span class="fl" aria-hidden="true">→</span></a></li>
</ul></section></div>

