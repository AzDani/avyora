.av-home .hero{background:linear-gradient(150deg,var(--nuit),var(--nuit-2) 55%,var(--nuit-3));color:#fff;position:relative;overflow:hidden;box-shadow:var(--shadow-hero);border-radius:var(--r-lg)}
