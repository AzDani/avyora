"<div class="space-y-6"><div class="flex flex-wrap items-start justify-between gap-4"><div><a class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-brand-700" href="/projets"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Projets</a><button type="button" class="group mt-2 flex items-center gap-2 text-left" title="Renommer le projet"><h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Maison neuve · rapide</h1><span class="shrink-0 text-faint opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 16 16" fill="none"><path d="M11.5 2.5a1.4 1.4 0 0 1 2 2L6 12l-2.7.7L4 10l7.5-7.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg></span></button><div class="mt-2.5 flex flex-wrap gap-1.5"><span class="chip num">100<!-- --> m²</span><span class="chip num">45000</span><span class="chip">Moyenne nationale</span><span class="chip">Construction neuve</span></div></div><div class="flex flex-col items-end gap-2"><div class="flex shrink-0 flex-wrap items-center justify-end gap-2"><a class="btn btn-outline py-2 text-[13px]" href="/projets/00000000-0000-4000-8000-000000000003/modifier"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M11.5 2.5a1.4 1.4 0 0 1 2 2L6 12l-2.7.7L4 10l7.5-7.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>Modifier</a><button class="btn btn-ghost py-2 text-[13px]" title="Archiver">Archiver</button><button class="btn btn-ghost py-2 text-[13px] text-faint hover:!bg-danger-soft hover:!text-danger" title="Supprimer le projet" aria-label="Supprimer le projet"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 4.5h10M6.5 4.5V3.2c0-.4.3-.7.7