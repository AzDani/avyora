exports[`Row · props du neuf > badge jalon fr · déclaration d'ouverture de chantier 1`] = `"<div class="trow"><button class="cbx on" aria-label="Décocher"></button><span class="tn">Déclaration d&#x27;ouverture de chantier en mairie (démarche gratuite)<span class="pu"><span class="badge-dem">Démarche</span><span class="punote"> · Formulaire déposé en mairie le jour où les travaux commencent. Aucun coût.</span></span></span><span class="tctl"><button type="button" class="notebtn" title="Ajouter une note / un lien">📝</button></span></div>"`;

exports[`Row · props du neuf > badge pct en · assurance dommages-ouvrage (% du projet, sans TVA) 1`] = `"<div class="trow"><button class="cbx on" aria-label="Décocher"></button><span class="tn">Builder&#x27;s latent-defect insurance (dommages-ouvrage, mandatory, taken out before work starts)<span class="pu"><span class="puval" title="Double-clique pour ajuster à ton prix">6 493 € · no VAT</span><span class="punote"> · One-off premium as a percentage of the total build cost: 2.5 to 4.5% with separate trades (one contractor per trade), 1.2 to 2% through a house builder. It is not work: no VAT and no labor. Many insurers apply a minimum flat fee (≈ €3,100 to €3,600 incl. VAT up to €220,000 of works). They may require a G2 soil study and a project manager (professional who designs and supervises the build). More expensive for self-builds.</span></span></span><span class="tctl"><span class="badge-pct">3.5 % of the project</span><button type="button" class="notebtn" title="Ajouter une note / un lien">📝</button><span class="lineamt num">6 493 €</span></span></div>"`;

exports[`Row · props du neuf > badge pct en · maîtrise d'œuvre avec un prix perso : plus de pourcentage affiché 1`] = `"<div class="trow"><button class="cbx on" aria-label="Décocher"></button><span class="tn">Architect or project manager: full mission (drawings, choice of tradespeople, site supervision, handover)<span class="pu edited"><span class="puval" title="Double-clique pour ajuster à ton prix">12 000 € HT</span><span class="pubadge">perso</span><button type="button" class="pureset" title="Rétablir le prix AVYORA par défaut">↺</button><span class="punote"> · As a percentage of the works cost excl. VAT, decreasing: ≈ 13 to 15% under €100,000 of works, 10 to 11% from €150,000 to €250,000. Replaces the two &quot;permit file&quot; items. Makes the latent-defect insurance easier to get.</span></span></span><span class="tctl"><button type="button" class="notebtn" title="Ajouter une note / un lien">📝</button><span class="lineamt num">12 000 €</span></span></div>"`;

exports[`Row · props du neuf > badge pct fr · assurance dommages-ouvrage (% du projet, sans TVA) 1`] = `"<div class="trow"><button class="cbx on" aria-label="Décocher"></button><span class="tn">Assurance dommages-ouvrage (obligatoire, souscrite avant l&#x27;ouverture du chantier)<span class="pu"><span class="puval" title="Double-clique pour ajuster à ton prix">6 493 € · sans TVA</span><span class="punote"> · Prime unique en pourcentage du coût total de construction : 2,5 à 4,5 % en lots séparés (un artisan par métier), 1,2 à 2 % via un constructeur. Ce n&#x27;est pas un travail : ni TVA ni main-d&#x27;œuvre. Beaucoup d&#x27;assureurs appliquent un forfait minimal (≈ 3 100 à 3 600 € TTC jusqu&#x27;à 220 000 € de travaux). Ils peuvent exiger une étude de sol G2 et un maître d&#x27;œuvre (professionnel qui conçoit et suit le chantier). Plus chère en auto-construction.</span></span></span><span class="tctl"><span class="badge-pct">3,5 % du projet</span><button type="button" class="notebtn" title="Ajouter une note / un lien">📝</button><span class="lineamt num">6 493 €</span></span></div>"`;

exports[`Row · props du neuf > badge pct fr · maîtrise d'œuvre avec un prix perso : plus de pourcentage affiché 1`] = `"<div class="trow"><button class="cbx on" aria-label="Décocher"></button><span class="tn">Architecte ou maître d&#x27;œuvre : mission complète (plans, choix des artisans, suivi du chantier, réception)<span class="pu edited"><span class="puval" title="Double-clique pour ajuster à ton prix">12 000 € HT</span><span class="pubadge">perso</span><button type="button" class="pureset" title="Rétablir le prix AVYORA par défaut">↺</button><span class="punote"> · En pourcentage du montant HT des travaux, dégressif : ≈ 13 à 15 % sous 100 000 € de travaux, 10 à 11 % de 150 000 à 250 000 €. Remplace les deux postes « dossier de permis ». Facilite l&#x27;obtention de la dommages-ouvrage.</span></span></span><span class="tctl"><button type="button" class="notebtn" title="Ajouter une note / un lien">📝</button><span class="lineamt num">12 000 €</span></span></div>"`;
